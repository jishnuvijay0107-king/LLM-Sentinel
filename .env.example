# LLM-Sentinel Configuration
# Copy this file to .env to configure your live API keys

# Google Gemini API Key (Get free key at: https://aistudio.google.com)
GEMINI_API_KEY=

# Groq API Key (Get free ultra-fast key at: https://console.groq.com)
GROQ_API_KEY=

# OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY=

# Local Ollama Host (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Sentinel Gateway Settings
SENTINEL_API_URL=http://127.0.0.1:8001
